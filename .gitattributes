# Auto detect text files and perform LF normalization
* text=auto

# Frontend
*.vue linguist-language=Vue
*.ts linguist-language=TypeScript
*.js linguist-language=JavaScript
*.css linguist-language=CSS
*.html linguist-language=HTML

# Backend
*.py linguist-language=Python
requirements.txt linguist-language=Python

# Documentation
*.md text
*.txt text

# Configuration files
*.json text
*.yaml text
*.yml text
*.config.js text
*.env.example text

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.svg text

# Lock files
package-lock.json binary
yarn.lock binary

# Enforce Unix line endings
*.vue text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.py text eol=lf
*.css text eol=lf
*.md text eol=lf

# Vendored code
frontend/node_modules/* linguist-vendored
backend/venv/* linguist-vendored
